{
  "name": "syn",
  "version": "1.0.0",
  "description": "Syn — a unified agent memory environment: search sessions + Memory Vault via the /locate engine and brainmaxxing console",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "test": "node test/search.test.js"
  },
  "keywords": [
    "sessions",
    "search",
    "archive",
    "harness",
    "agent",
    "copilot"
  ],
  "author": "xen38",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.xen38.syn",
    "productName": "Syn",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "icon": "assets/icon.icns"
    },
    "linux": {
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.2.0",
    "sql.js": "^1.10.0"
  }
}
